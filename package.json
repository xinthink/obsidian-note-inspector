{
  "name": "obsidian-note-inspector",
  "version": "1.0.3",
  "description": "Obsidian plugin: an inspector panel for the active note — properties, outline and footnotes in one collapsible view.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "check": "node scripts/check-manifest.mjs",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint:css": "stylelint styles.css"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "frontmatter",
    "properties",
    "outline",
    "footnotes",
    "sidebar"
  ],
  "license": "MIT",
  "author": "xinthink",
  "homepage": "https://github.com/xinthink/obsidian-note-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinthink/obsidian-note-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/xinthink/obsidian-note-inspector/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "stylelint": "^17.15.0",
    "stylelint-config-obsidianmd": "^0.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
